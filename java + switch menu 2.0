import java.util.Scanner;

public class Main {

    static Scanner tc = new Scanner(System.in);

    public static void main(String[] args) {

        int op;

        do {
            System.out.println("\n===== MENU =====");
            System.out.println("1 - Questão 01");
            System.out.println("2 - Questão 02");
            System.out.println("3 - Questão 03");
            System.out.println("4 - Questão 04");
            System.out.println("5 - Questão 05");
            System.out.println("6 - Questão 06");
            System.out.println("7 - Questão 07");
            System.out.println("8 - Questão 08");
            System.out.println("9 - Questão 09");
            System.out.println("10 - Questão 10");
            System.out.println("11 - Questão 11");
            System.out.println("12 - Questão 12");
            System.out.println("13 - Questão 13");
            System.out.println("14 - Questão 14");
            System.out.println("0 - SAIR");
            System.out.print("Escolha: ");

            op = tc.nextInt();

            switch (op) {
                case 1:
                    questao01();
                    break;
                case 2:
                    questao02();
                    break;
                case 3:
                    questao03();
                    break;
                case 4:
                    questao04();
                    break;
                case 5:
                    questao05();
                    break;
                case 6:
                    questao06();
                    break;
                case 7:
                    questao07();
                    break;
                case 8:
                    questao08();
                    break;
                case 9:
                    questao09();
                    break;
                case 10:
                    questao10();
                    break;
                case 11:
                    questao11();
                    break;
                case 12:
                    questao12();
                    break;
                case 13:
                    questao13();
                    break;
                case 14:
                    questao14();
                    break;
                case 0:
                    System.out.println("Saindo...");
                    break;
                default:
                    System.out.println("Opção inválida!");
            }

        } while (op != 0);
    }

    public static void questao01() {

        int A, B;

        System.out.print("Digite o primeiro numero: ");
        A = tc.nextInt();

        System.out.print("Digite o segundo numero: ");
        B = tc.nextInt();

        if (A > B) {
            System.out.println("Maior - " + A + " / Menor - " + B);
        } else if (B > A) {
            System.out.println("Maior - " + B + " / Menor - " + A);
        } else {
            System.out.println("Os números são iguais!");
        }
    }

    public static void questao02() {

        int A, B;
        double media;

        System.out.print("Digite o primeiro numero: ");
        A = tc.nextInt();

        System.out.print("Digite o segundo numero: ");
        B = tc.nextInt();

        media = (A + B) / 2.0;

        System.out.println("Média: " + media);
    }

    public static void questao03() {

        int num;

        System.out.print("Digite um numero: ");
        num = tc.nextInt();

        if (num % 2 == 0) {
            System.out.println("O número é PAR.");
        } else {
            System.out.println("O número é ÍMPAR.");
        }
    }

    public static void questao04() {

        int nascimento;
        int idade;

        System.out.print("Digite o ano de nascimento: ");
        nascimento = tc.nextInt();

        idade = 2026 - nascimento;

        System.out.println("Idade atual: " + idade);
    }

    public static void questao05() {

        int num;

        System.out.print("Digite um numero: ");
        num = tc.nextInt();

        System.out.println("Antecessor: " + (num - 1));
        System.out.println("Sucessor: " + (num + 1));
    }

    public static void questao06() {

        double n1, n2, n3, media;

        System.out.print("Digite a primeira nota: ");
        n1 = tc.nextDouble();

        System.out.print("Digite a segunda nota: ");
        n2 = tc.nextDouble();

        System.out.print("Digite a terceira nota: ");
        n3 = tc.nextDouble();

        media = (n1 + n2 + n3) / 3;

        System.out.println("Média: " + media);

        if (media >= 7) {
            System.out.println("APROVADO");
        } else {
            System.out.println("REPROVADO");
        }
    }

    public static void questao07() {

        double n1, n2, n3, media;

        for (int i = 1; i <= 20; i++) {

            System.out.println("\nAluno " + i);

            System.out.print("Digite a primeira nota: ");
            n1 = tc.nextDouble();

            System.out.print("Digite a segunda nota: ");
            n2 = tc.nextDouble();

            System.out.print("Digite a terceira nota: ");
            n3 = tc.nextDouble();

            media = (n1 + n2 + n3) / 3;

            if (media > 8) {
                System.out.println("Média acima de 8: " + media);
            }
        }
    }

    public static void questao08() {

        int num;
        int quantidade = 0;

        for (int i = 1; i <= 80; i++) {

            System.out.print("Digite o " + i + "º número: ");
            num = tc.nextInt();

            if (num >= 10 && num <= 150) {
                quantidade++;
            }
        }

        System.out.println("Quantidade entre 10 e 150: " + quantidade);
    }

    public static void questao09() {

        String nome;
        double salario, vendas, salarioFinal;

        tc.nextLine();

        System.out.print("Digite o nome do vendedor: ");
        nome = tc.nextLine();

        System.out.print("Digite o salário fixo: ");
        salario = tc.nextDouble();

        System.out.print("Digite o total de vendas: ");
        vendas = tc.nextDouble();

        salarioFinal = salario + (vendas * 0.15);

        System.out.println("Nome: " + nome);
        System.out.println("Salário final: R$ " + salarioFinal);
    }

    public static void questao10() {

        int num;
        int pares = 0;
        int impares = 0;

        for (int i = 1; i <= 10; i++) {

            System.out.print("Digite o " + i + "º número: ");
            num = tc.nextInt();

            if (num % 2 == 0) {
                pares++;
            } else {
                impares++;
            }
        }

        System.out.println("Quantidade de pares: " + pares);
        System.out.println("Quantidade de ímpares: " + impares);
    }

    public static void questao11() {

        int num;
        int somaPares = 0;
        int somaImpares = 0;
        int quantidadeImpares = 0;
        double mediaImpares;

        for (int i = 1; i <= 10; i++) {

            System.out.print("Digite o " + i + "º número: ");
            num = tc.nextInt();

            if (num % 2 == 0) {
                somaPares += num;
            } else {
                somaImpares += num;
                quantidadeImpares++;
            }
        }

        System.out.println("Soma dos pares: " + somaPares);

        if (quantidadeImpares > 0) {
            mediaImpares = (double) somaImpares / quantidadeImpares;
            System.out.println("Média dos ímpares: " + mediaImpares);
        } else {
            System.out.println("Não foram digitados números ímpares.");
        }
    }

    public static void questao12() {

        int num;
        int somaPositivos = 0;
        int quantidadeNegativos = 0;

        for (int i = 1; i <= 50; i++) {

            System.out.print("Digite o " + i + "º valor: ");
            num = tc.nextInt();

            if (num > 0) {
                somaPositivos += num;
            } else if (num < 0) {
                quantidadeNegativos++;
            }
        }

        System.out.println("Soma dos positivos: " + somaPositivos);
        System.out.println("Quantidade de negativos: " + quantidadeNegativos);
    }

    public static void questao13() {

        int soma = 0;

        System.out.println("Números pares entre 85 e 907:");

        for (int i = 85; i <= 907; i++) {

            if (i % 2 == 0) {
                System.out.println(i);
                soma += i;
            }
        }

        System.out.println("Soma dos pares: " + soma);
    }

    public static void questao14() {

        String nome;
        String maisPesada = "";
        String maisAlta = "";

        double peso;
        double altura;
        double maiorPeso = 0;
        double maiorAltura = 0;

        tc.nextLine();

        for (int i = 1; i <= 20; i++) {

            System.out.println("\nPessoa " + i);

            System.out.print("Digite o nome: ");
            nome = tc.nextLine();

            System.out.print("Digite a altura: ");
            altura = tc.nextDouble();

            System.out.print("Digite o peso: ");
            peso = tc.nextDouble();

            tc.nextLine();

            if (peso > maiorPeso) {
                maiorPeso = peso;
                maisPesada = nome;
            }

            if (altura > maiorAltura) {
                maiorAltura = altura;
                maisAlta = nome;
            }
        }

        System.out.println("\n===== RESULTADO =====");
        System.out.println("Pessoa mais pesada: " + maisPesada);
        System.out.println("Peso: " + maiorPeso + " kg");

        System.out.println("Pessoa mais alta: " + maisAlta);
        System.out.println("Altura: " + maiorAltura + " m");
    }
}
