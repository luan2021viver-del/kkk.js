class Televisao {

    boolean ligada;
    int volume;
    int canal;

    public Televisao() {
        ligada = false;
        volume = 0;
        canal = 0;
    }

    void ligar() {
        ligada = true;
    }

    void desligar() {
        ligada = false;
    }

    void aumentarVolume() {
        if (volume < 100) {
            volume++;
        } else {
            System.out.println("Volume Máximo!");
        }
    }

    void diminuirVolume() {
        if (volume > 0) {
            volume--;
        } else {
            System.out.println("Mudo!");
        }
    }

    void aumentarCanal() {
        canal++;
    }

    void diminuirCanal() {
        if (canal > 0) {
            canal--;
        }
    }

    void trocarCanal(int novoCanal) {
        canal = novoCanal;
    }

    void status() {
        System.out.println("TV ligada: " + ligada);
        System.out.println("Volume: " + volume);
        System.out.println("Canal: " + canal);
    }
}

class ControleRemoto {

    Televisao tv;

    public ControleRemoto(Televisao tv) {
        this.tv = tv;
    }

    void ligar() {
        tv.ligar();
    }

    void desligar() {
        tv.desligar();
    }

    void aumentarVolume() {
        tv.aumentarVolume();
    }

    void diminuirVolume() {
        tv.diminuirVolume();
    }

    void aumentarCanal() {
        tv.aumentarCanal();
    }

    void diminuirCanal() {
        tv.diminuirCanal();
    }

    void trocarCanal(int canal) {
        tv.trocarCanal(canal);
    }

    void status() {
        tv.status();
    }
}

public class Main {

    public static void main(String[] args) {

        Televisao samsung = new Televisao();

        ControleRemoto controle = new ControleRemoto(samsung);

        controle.status();

        controle.ligar();

        controle.aumentarVolume();
        controle.aumentarVolume();

        controle.aumentarCanal();

        controle.status();

        controle.trocarCanal(10);

        controle.diminuirVolume();
        controle.diminuirCanal();

        controle.status();

        controle.desligar();

        controle.status();
    }
}
