SELECT * FROM livros;

SELECT * FROM leitores;

SELECT * FROM Emprestimos;

SELECT
    leitores.nome,
    livros.nome AS livro,
    Emprestimos.data_emprestimo
FROM Emprestimos
INNER JOIN leitores
    ON Emprestimos.id_lei = leitores.id_lei
INNER JOIN livros
    ON Emprestimos.id_livro = livros.id_livro;

SELECT
    leitores.nome,
    livros.nome AS livro
FROM leitores
LEFT JOIN Emprestimos
    ON leitores.id_lei = Emprestimos.id_lei
LEFT JOIN livros
    ON Emprestimos.id_livro = livros.id_livro;


SELECT
    leitores.nome,
    livros.nome AS livro,
    Emprestimos.data_prevista
FROM Emprestimos
INNER JOIN leitores
    ON Emprestimos.id_lei = leitores.id_lei
INNER JOIN livros
    ON Emprestimos.id_livro = livros.id_livro
WHERE Emprestimos.data_devolucao IS NULL;
