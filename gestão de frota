public interface OperacoesFrota {
    boolean adicionarVeiculo(Veiculo veiculo);
    boolean removerVeiculo(String codigo);
    Veiculo procurarVeiculo(String codigo);
    java.util.List<Veiculo> procurarPorCategoria(CategoriaVeiculo categoria);
    boolean atualizarValorDiaria(String codigo, double novoValor);
    void listarFrota();
}



public class GestaoFrota implements OperacoesFrota {
    private java.util.List<Veiculo> frota;

    public GestaoFrota() {
        this.frota = new java.util.ArrayList<>();
    }

    @Override
    public boolean adicionarVeiculo(Veiculo veiculo) {
        if (veiculo == null) return false;
        for (Veiculo v : frota) {
            if (v.getCodigo().equalsIgnoreCase(veiculo.getCodigo())) {
                System.out.println("Erro: Já existe um veículo com o código " + veiculo.getCodigo());
                return false;
            }
        }
        frota.add(veiculo);
        System.out.println("Veículo " + veiculo.getCodigo() + " adicionado com sucesso.");
        return true;
    }

    @Override
    public boolean removerVeiculo(String codigo) {
        Veiculo v = procurarVeiculo(codigo);
        if (v != null) {
            frota.remove(v);
            System.out.println("Veículo " + codigo + " removido com sucesso.");
            return true;
        }
        System.out.println("Erro: Veículo com código " + codigo + " não encontrado para remoção.");
        return false;
    }

    @Override
    public Veiculo procurarVeiculo(String codigo) {
        for (Veiculo v : frota) {
            if (v.getCodigo().equalsIgnoreCase(codigo)) {
                return v;
            }
        }
        return null;
    }

    @Override
    public java.util.List<Veiculo> procurarPorCategoria(CategoriaVeiculo categoria) {
        java.util.List<Veiculo> resultado = new java.util.ArrayList<>();
        for (Veiculo v : frota) {
            if (v.getCategoria() == categoria) {
                resultado.add(v);
            }
        }
        return resultado;
    }

    @Override
    public boolean atualizarValorDiaria(String codigo, double novoValor) {
        Veiculo v = procurarVeiculo(codigo);
        if (v != null) {
            v.setValorDiaria(novoValor);
            System.out.println("Valor da diária do veículo " + codigo + " atualizado com sucesso.");
            return true;
        }
        System.out.println("Erro: Veículo com código " + codigo + " não encontrado.");
        return false;
    }

    @Override
    public void listarFrota() {
        if (frota.isEmpty()) {
            System.out.println("A frota está vazia.");
            return;
        }
        System.out.println("\n=== LISTAGEM COMPLETA DA FROTA ===");
        for (Veiculo v : frota) {
            v.exibirFichaTecnica();
        }
    }
}
public class Main {
    public static void main(String[] args) {
        System.out.println("=== SISTEMA DE GESTÃO DE FROTA - MOVEMAIS ===\n");

        System.out.println("--- 1. Instanciação de Veículos ---");
        Carro carro1 = new Carro("CAR-001", "Corolla", "Toyota", 150.0, EstadoVeiculo.DISPONIVEL, 470, "Flex");
        Carro carro2 = new Carro("CAR-002", "Civic", "Honda", 160.0, EstadoVeiculo.EM_MANUTENCAO, 519, "Gasolina");
        Caminhao caminhao1 = new Caminhao("CAM-901", "FH 540", "Volvo", 650.0, EstadoVeiculo.EM_TRANSITO, 45.0, 6);

        System.out.println("\n--- 2. Consulta Global de Instâncias ---");
        System.out.println("Total de veículos criados no sistema: " + Veiculo.getContadorGlobal());

        System.out.println("\n--- 3. Adição à Frota ---");
        GestaoFrota gestao = new GestaoFrota();
        gestao.adicionarVeiculo(carro1);
        gestao.adicionarVeiculo(carro2);
        gestao.adicionarVeiculo(caminhao1);

        gestao.adicionarVeiculo(new Carro("CAR-001", "Etios", "Toyota", 100.0, EstadoVeiculo.DISPONIVEL, 300, "Flex"));

        System.out.println("\n--- 4. Listagem Inicial da Frota ---");
        gestao.listarFrota();

        System.out.println("\n--- 5. Busca Filtrada por Categoria (CARRO) ---");
        java.util.List<Veiculo> carros = gestao.procurarPorCategoria(CategoriaVeiculo.CARRO);
        for (Veiculo v : carros) {
            v.exibirFichaTecnica();
        }

        System.out.println("\n--- 6. Operações de Manutenção (Atualização e Remoção) ---");
        gestao.atualizarValorDiaria("CAR-001", 185.50);
        gestao.removerVeiculo("CAR-002");

        System.out.println("\n--- 7. Validação Final da Frota ---");
        gestao.listarFrota();

        System.out.println("Exemplo de formatação monetária avulsa via utilitário: " + FormatadorMoeda.formatar(2500.75));
    }
}


public enum EstadoVeiculo {
    DISPONIVEL,
    EM_MANUTENCAO,
    EM_TRANSITO
}


public class FormatadorMoeda {
    private static final java.util.Locale LOCALE_BR = new java.util.Locale("pt", "BR");

    public static String formatar(double valor) {
        java.text.NumberFormat nf = java.text.NumberFormat.getCurrencyInstance(LOCALE_BR);
        return nf.format(valor);
    }
}
