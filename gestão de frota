\\Veiculo
public abstract class Veiculo {
    private static int contadorGlobal = 0;

    private String codigo;
    private String modelo;
    private String marca;
    private double valorDiaria;
    private CategoriaVeiculo categoria;
    private EstadoVeiculo estado;

    public Veiculo(String codigo, String modelo, String marca, double valorDiaria, CategoriaVeiculo categoria, EstadoVeiculo estado) {
        setCodigo(codigo);
        setModelo(modelo);
        setMarca(marca);
        setValorDiaria(valorDiaria);
        setCategoria(categoria);
        setEstado(estado);
        contadorGlobal++;
    }

    public static int getContadorGlobal() {
        return contadorGlobal;
    }

    public String getCodigo() {
        return codigo;
    }

    public void setCodigo(String codigo) {
        if (codigo == null || codigo.trim().isEmpty()) {
            throw new IllegalArgumentException("O código identificador não pode ser nulo nem vazio.");
        }
        this.codigo = codigo;
    }

    public String getModelo() {
        return modelo;
    }

    public void setModelo(String modelo) {
        this.modelo = modelo;
    }

    public String getMarca() {
        return marca;
    }

    public void setMarca(String marca) {
        this.marca = marca;
    }

    public double getValorDiaria() {
        return valorDiaria;
    }

    public void setValorDiaria(double valorDiaria) {
        if (valorDiaria <= 0) {
            throw new IllegalArgumentException("O valor da diária não pode ser negativo nem zero.");
        }
        this.valorDiaria = valorDiaria;
    }

    public CategoriaVeiculo getCategoria() {
        return categoria;
    }

    public void setCategoria(CategoriaVeiculo categoria) {
        if (categoria == null) {
            throw new IllegalArgumentException("A categoria não pode ser nula.");
        }
        this.categoria = categoria;
    }

    public EstadoVeiculo getEstado() {
        return estado;
    }

    public void setEstado(EstadoVeiculo estado) {
        if (estado == null) {
            throw new IllegalArgumentException("O estado não pode ser nulo.");
        }
        this.estado = estado;
    }

    public abstract void exibirFichaTecnica();
}

}


