class Carro {

    String cor;
    String modelo;
    double velocidadeAtual;
    double velocidadeMaxima;

    void liga() {
        System.out.println("Carro ligado");
    }
    void acelera(double quantidade) {
        velocidadeAtual += quantidade;
        if (velocidadeAtual > velocidadeMaxima) {
            velocidadeAtual = velocidadeMaxima;
        }
    }
    int passarMarcha() {
        if (velocidadeAtual <= 20) {
            return 1;
        } else if (velocidadeAtual <= 40) {
            return 2;
        } else if (velocidadeAtual <= 60) {
            return 3;
        } else if (velocidadeAtual <= 100) {
            return 4;
        } else {
            return 5;
        }
    }
    void status() {
        System.out.println("Cor: " + cor);
        System.out.println("Modelo: " + modelo);
        System.out.println("Velocidade: " + velocidadeAtual);
        System.out.println("Marcha: " + passarMarcha());
    }
}

public class Main {

    public static void main(String[] args) {
        Carro carro = new Carro();
        carro.cor = "Preto";
        carro.modelo = "Civic";
        carro.velocidadeMaxima = 180;
        carro.liga();
        carro.acelera(30);
        carro.status();
        carro.acelera(40);
        carro.status();
        carro.acelera(50);
        carro.status();
    }
}
