DROP DATABASE IF EXISTS CLIENTES;

CREATE DATABASE CLIENTES;

USE CLIENTES;

CREATE TABLE INFOCLIENTES (
    id_clientes INT PRIMARY KEY AUTO_INCREMENT NOT NULL,
    nome VARCHAR(100),
    email VARCHAR(100),
    cpf VARCHAR(14)
);

CREATE TABLE pedidos (
    id_pedidos INT PRIMARY KEY AUTO_INCREMENT NOT NULL,
    id_clientes INT,
    data_pedido DATE,
    valor_total DECIMAL(10,2),
    FOREIGN KEY (id_clientes) REFERENCES INFOCLIENTES(id_clientes)
);

