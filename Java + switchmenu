import java.util.Scanner;

public class Main {

    static Scanner tc = new Scanner(System.in);

    public static void main(String[] args) {

        int op;

        do {
            System.out.println("\n===== MENU =====");
            System.out.println("1 - Questão 01");
            System.out.println("2 - Questão 02");
            System.out.println("3 - Questão 03");
            System.out.println("4 - Questão 04");
            System.out.println("5 - Questão 05");
            System.out.println("0 - SAIR");
            System.out.print("Escolha: ");

            op = tc.nextInt();

            switch (op) {

                case 1:
                    questao01();
                    break;

                case 2:
                    questao02();
                    break;

                case 3:
                    questao03();
                    break;

                case 4:
                    questao04();
                    break;

                case 5:
                    questao05();
                    break;

                case 0:
                    System.out.println("Saindo...");
                    break;

                default:
                    System.out.println("Opção inválida!");
            }

        } while (op != 0);
    }

    public static void questao01() {

        int A, B;

        System.out.print("Digite o primeiro numero: ");
        A = tc.nextInt();

        System.out.print("Digite o segundo numero: ");
        B = tc.nextInt();

        if (A > B) {
            System.out.println("Maior - " + A + " / Menor - " + B);
        } else if (B > A) {
            System.out.println("Maior - " + B + " / Menor - " + A);
        } else {
            System.out.println("Os números são iguais!");
        }
    }

    public static void questao02() {

        int A, B;
        double media;

        System.out.print("Digite o primeiro numero: ");
        A = tc.nextInt();

        System.out.print("Digite o segundo numero: ");
        B = tc.nextInt();

        media = (A + B) / 2.0;

        System.out.println("Média: " + media);
    }

    public static void questao03() {

        int num;

        System.out.print("Digite um numero: ");
        num = tc.nextInt();

        if (num % 2 == 0) {
            System.out.println("O número é PAR.");
        } else {
            System.out.println("O número é ÍMPAR.");
        }
    }

    public static void questao04() {

        int nascimento;
        int idade;

        System.out.print("Digite o ano de nascimento: ");
        nascimento = tc.nextInt();

        idade = 2026 - nascimento;

        System.out.println("Idade atual: " + idade);
    }

    public static void questao05() {

        int num;

        System.out.print("Digite um numero: ");
        num = tc.nextInt();

        System.out.println("Antecessor: " + (num - 1));
        System.out.println("Sucessor: " + (num + 1));
    }
}
