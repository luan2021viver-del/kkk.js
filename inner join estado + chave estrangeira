DROP DATABASE IF EXISTS Cadastro;

CREATE DATABASE cadastro;

USE cadastro;

CREATE TABLE Estado (
    idE INT PRIMARY KEY AUTO_INCREMENT,
    nome VARCHAR(100) NOT NULL,
    região VARCHAR(50)
 
);

CREATE TABLE cidade (
    idC INT PRIMARY KEY AUTO_INCREMENT,
    nome VARCHAR(100) NOT NULL,
    idE INT,
      FOREIGN KEY (idE) REFERENCES Estado(idE)
);


