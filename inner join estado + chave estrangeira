DROP DATABASE IF EXISTS Cadastro;

CREATE DATABASE Cadastro;

USE Cadastro;


Create Table Pais ( 
idP INT PRIMARY KEY AUTO_INCREMENT,
nome Varchar (50),
Continente Varchar(50)

);


CREATE TABLE Estado (
    idE INT PRIMARY KEY AUTO_INCREMENT,
    nome VARCHAR(100) NOT NULL,
    região VARCHAR(50),
    sigla varchar(50),
    idP Int,
    FOREIGN KEY (idP) REFERENCES Pais(idP)
);

CREATE TABLE cidade (
    idC INT PRIMARY KEY AUTO_INCREMENT,
    nome VARCHAR(100) NOT NULL,
    idE INT,
    FOREIGN KEY (idE) REFERENCES Estado(idE)
);

CREATE TABLE endereço (
    idEN INT PRIMARY KEY AUTO_INCREMENT,
    bairro VARCHAR(200),
    rua VARCHAR(200),
    numero INT,
    idE INT,
    idC INT,
    FOREIGN KEY (idC) REFERENCES cidade(idC),
    FOREIGN KEY (idE) REFERENCES Estado(idE)
);

CREATE TABLE Cliente(
idCL INT PRIMARY KEY AUTO_INCREMENT,
nome varchar(50),
cpf int,
data_nasc DATE,
sexo varchar (50),
email varchar (50),
idEN INT,
 FOREIGN KEY (idEN) REFERENCES endereço (idEN)

);

