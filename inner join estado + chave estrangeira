SELECT Cliente.nome, Estado.nome
FROM Cliente
INNER JOIN endereço ON Cliente.idEN = endereço.idEN
INNER JOIN Estado ON endereço.idE = Estado.idE;

SELECT cidade.nome, Estado.nome
FROM cidade
INNER JOIN Estado ON cidade.idE = Estado.idE;

SELECT Estado.nome, Pais.nome
FROM Estado
INNER JOIN Pais ON Estado.idP = Pais.idP;

SELECT Cliente.nome, Pais.nome
FROM Cliente
INNER JOIN endereço ON Cliente.idEN = endereço.idEN
INNER JOIN Estado ON endereço.idE = Estado.idE
INNER JOIN Pais ON Estado.idP = Pais.idP;


