#include <stdio.h>

int main() {
    int num[3];
    int i, j, aux;

    printf("Digite tres numeros inteiros: ");
    scanf("%d %d %d", &num[0], &num[1], &num[2]);

    for (i = 0; i < 2; i++) {
        for (j = i + 1; j < 3; j++) {
            if (num[i] < num[j]) {
                aux = num[i];
                num[i] = num[j];
                num[j] = aux;
            }
        }
    }

    printf("Maior: %d\n", num[0]);
    printf("Intermediario: %d\n", num[1]);
    printf("Menor: %d\n", num[2]);

    return 0;
}
