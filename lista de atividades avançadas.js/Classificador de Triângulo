#include <stdio.h>

int main() {
    float A, B, C; 

    printf("Digite o lado A do triangulo: ");
    scanf("%f", &A);

    printf("Digite o lado B do triangulo: ");
    scanf("%f", &B);
    
    printf("Digite o lado C do triangulo: ");
    scanf("%f", &C);

    if (A < B + C && B < A + C && C < A + B) {
        if (A == B && B == C) {
            printf("\nO triangulo é Equilatero\n");
        }
        else if (A == B || A == C || B == C) {
            printf("\nO triangulo é Isosceles\n");
        }
        else {
            printf("\nO triangulo é Escaleno\n");
        }
    } 
    return 0;
}
