#include <stdio.h>

int main() {
    int N, i;
    int soma = 0;
    float media;

    printf("Digite um numero inteiro positivo: ");
    scanf("%d", &N);

    for(i = 1; i <= N; i++) {
        soma += i;
    }

    media = (float)soma / N;

    printf("Soma dos numeros de 1 ate %d = %d\n", N, soma);
    printf("Media = %.2f\n", media);

    return 0;
}
