#include <stdio.h>

int main() {
    int v[5], i;

    for(i = 0; i < 5; i++) {
        printf("Digite um valor: ");
        scanf("%d", &v[i]);
    }

    printf("\nOrdem original:\n");

    for(i = 0; i < 5; i++) {
        printf("%d ", v[i]);
    }

    printf("\nOrdem inversa:\n");

    for(i = 4; i >= 0; i--) {
        printf("%d ", v[i]);
    }

    return 0;
}
