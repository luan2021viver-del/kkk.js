#include <stdio.h>

int main() {
    int opcao = 0;
    float num;

    while (opcao != 3) {
        printf("\n--- MENU ---\n");
        printf("1: Dobro\n");
        printf("2: Quadrado\n");
        printf("3: Sair\n");
        printf("Escolha: ");
        scanf("%d", &opcao);

        switch (opcao) {
            case 1:
                printf("Numero: ");
                scanf("%f", &num);
                printf("Resultado: %.2f\n", num * 2);
                break;
            case 2:
                printf("Numero: ");
                scanf("%f", &num);
                printf("Resultado: %.2f\n", num * num);
                break;
            case 3:
                printf("Saindo...\n");
                break;
            default:
                printf("Invalido!\n");
        }
    }

    return 0;
}
