#include <stdio.h>

#define MAX 100

typedef struct {
    char dados[MAX];
    int topo;
} Pilha;

void inicializar(Pilha *p) {
    p->topo = -1;
}

int estaVazia(Pilha *p) {
    return p->topo == -1;
}

int estaCheia(Pilha *p) {
    return p->topo == MAX - 1;
}

void push(Pilha *p, char valor) {
    if (!estaCheia(p))
        p->dados[++p->topo] = valor;
}

char pop(Pilha *p) {
    if (estaVazia(p))
        return '\0';

    return p->dados[p->topo--];
}

int main() {
    Pilha p;
    int n;

    inicializar(&p);

    printf("Digite um numero: ");
    scanf("%d", &n);

    printf("%d --->>> ", n);

    if (n == 0) {
        printf("0");
        return 0;
    }

    while (n > 0) {
        push(&p, n % 2);
        n /= 2;
    }

    while (!estaVazia(&p)) {
        printf("%d", pop(&p));
    }

    printf("\n");

    return 0;
}
