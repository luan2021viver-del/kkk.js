#include <stdio.h>

int main() {
    int v[8], i, busca, encontrado = 0, quantidade = 0;

    for(i = 0; i < 8; i++) {
        printf("Digite um valor: ");
        scanf("%d", &v[i]);
    }

    printf("Digite o valor a ser buscado: ");
    scanf("%d", &busca);

    for(i = 0; i < 8; i++) {
        if(v[i] == busca) {
            printf("Valor encontrado na posicao %d\n", i);
            encontrado = 1;
            quantidade++;
        }
    }

    if(encontrado == 0) {
        printf("Valor nao encontrado\n");
    } else {
        printf("Quantidade de vezes que apareceu: %d\n", quantidade);
    }

    return 0;
}
