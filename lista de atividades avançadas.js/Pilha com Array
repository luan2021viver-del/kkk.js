#include <stdio.h>
#define MAX 10

typedef struct {
    int dados[MAX]; /* os elementos    */
    int topo;       /* índice do topo  */
} Pilha;          /* -1 = vazia      */

void inicializar(Pilha *p) {
    p->topo = -1;
}
int estaVazia(Pilha *p) {
    return p->topo == -1;
}
int estaCheia(Pilha *p) {
    return p->topo == MAX - 1;
}
void push(Pilha *p, int valor) {
    if (estaCheia(p)) return;
    p->dados[++p->topo] = valor;
}

int pop(Pilha *p) {
    if (estaVazia(p)) return -1;
    return p->dados[--p->topo];
}

int peek(Pilha *p) {
    if (estaVazia(p)) return -1;
    return p->dados[p->topo];
}


int main()
{
    Pilha p;
inicializar(&p);
push(&p, 10); push(&p, 15); push(&p,45);
printf("%d\n", pop(&p));
   

    return 0;
}
