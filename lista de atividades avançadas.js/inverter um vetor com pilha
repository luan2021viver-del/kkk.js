#include <stdio.h>
#include <string.h>
#define MAX 100

typedef struct {
    char dados[MAX];
    int topo;
} Pilha;

void inicializar(Pilha *p) {
    p->topo = -1;
}

int estaVazia(Pilha *p) {
    return p->topo == -1;
}

int estaCheia(Pilha *p) {
    return p->topo == MAX - 1;
}

void push(Pilha *p, char valor) {
    if (estaCheia(p))
       return;

    p->dados[++p->topo] = valor;
}

char pop(Pilha *p) {
    if (estaVazia(p))
        return '\0';

    return p->dados[p->topo--];
}

int main() {
    Pilha p;
int v[] = {10, 20, 30, 40, 50, 60};
int i;
inicializar(&p);
printf("Original: ");
for(i = 0; i < 6; i++)
    printf("%d ", v[i]);

printf("\n");

for(i = 0; i < 6; i++)
    push(&p, v[i]);

for(i = 0; i < 6; i++)
    v[i] = pop(&p);

printf("Invertido: ");
for(i = 0; i < 6; i++)
    printf("%d ", v[i]);

printf("\n");
}
