#include <stdio.h>

typedef struct {
    char nome[50];
    float total;
    int pedido;
    int mesa;
} Cliente;

int main() {

    Cliente fila[5];

    for(int i = 0; i < 5; i++) {

        printf("\n--- Cliente %d ---\n", i + 1);

        printf("Digite o nome: ");
        scanf("%s", fila[i].nome);

        printf("Digite o total da compra: ");
        scanf("%f", &fila[i].total);

        printf("Digite o numero do pedido: ");
        scanf("%d", &fila[i].pedido);

        printf("Digite o numero da mesa: ");
        scanf("%d", &fila[i].mesa);
    }

    int buscarPedido;
    int encontrado = 0;

    printf("\nDigite o numero do pedido para buscar: ");
    scanf("%d", &buscarPedido);

    for(int i = 0; i < 5; i++) {

        if(fila[i].pedido == buscarPedido) {

            printf("\n--- CLIENTE ENCONTRADO ---\n");
            printf("Nome: %s\n", fila[i].nome);
            printf("Total: R$ %.2f\n", fila[i].total);
            printf("Pedido: %d\n", fila[i].pedido);
            printf("Mesa: %d\n", fila[i].mesa);

            encontrado = 1;
            break;
        }
    }

    if(encontrado == 0) {
        printf("\nPedido nao encontrado\n");
    }

    return 0;
}
