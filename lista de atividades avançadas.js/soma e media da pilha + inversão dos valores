#include <stdio.h>

#define MAX 10

typedef struct {
    int dados[MAX];
    int topo;
} Pilha;

void inicializar(Pilha *p) {
    p->topo = -1;
}

int estaVazia(Pilha *p) {
    return p->topo == -1;
}

int estaCheia(Pilha *p) {
    return p->topo == MAX - 1;
}

void push(Pilha *p, int valor) {
    if (!estaCheia(p)) {
        p->dados[++p->topo] = valor;
    }
}

int pop(Pilha *p) {
    if (estaVazia(p))
        return -1;
    return p->dados[p->topo--];
}

int peek(Pilha *p) {
    if (estaVazia(p))
        return -1;
    return p->dados[p->topo];
}

void exibirPilha(Pilha *p, char nome[]) {
    int i;

    printf("\n%s:\n", nome);

    if (estaVazia(p)) {
        printf("Vazia\n");
        return;
    }

    for (i = p->topo; i >= 0; i--) {
        printf("%d", p->dados[i]);
        if (i == p->topo)
            printf(" <- TOPO");
        printf("\n");
    }
}

int main() {
    Pilha H;
    Pilha lixeira;

    int opcao = 0;
    int valor;

    inicializar(&H);
    inicializar(&lixeira);

    while (opcao != 7) {

        printf("\n===== MENU =====\n");
        printf("1 - Executar nova acao\n");
        printf("2 - Desfazer\n");
        printf("3 - Refazer\n");
        printf("4 - Ver estado das pilhas\n");
        printf("5 - Mostrar soma e media\n");
        printf("6 - Mostrar pilha invertida\n");
        printf("7 - Sair\n");
        printf("Opcao: ");
        scanf("%d", &opcao);
        switch (opcao) {
            case 1:
                printf("Digite um valor: ");
                scanf("%d", &valor);
                push(&H, valor);
                inicializar(&lixeira);
                break;
            case 2:
                if (estaVazia(&H)) {
                    printf("Nada para desfazer\n");
                } else {
                    valor = pop(&H);
                    push(&lixeira, valor);
                    printf("Desfeito: %d\n", valor);
                }
                break;
            case 3:
                if (estaVazia(&lixeira)) {
                    printf("Nada para refazer\n");
                } else {
                    valor = pop(&lixeira);
                    push(&H, valor);
                    printf("Item refeito: %d\n", valor);
                }
                break;
            case 4:
                exibirPilha(&H, "HISTORICO");
                exibirPilha(&lixeira, "LIXEIRA");
                valor = peek(&H);
                if (valor == -1)
                    printf("\nHistorico vazio\n");
                else
                    printf("\nTopo do historico: %d\n", valor);
                break;
            case 5:
            {
                int soma = 0;
                int i;
                if (estaVazia(&H)) {
                    printf("Historico vazio\n");
                } else {
                    for (i = 0; i <= H.topo; i++) {
                        soma += H.dados[i];
                    }
                    printf("Soma: %d\n", soma);
                    printf("Media: %.2f\n", (float)soma / (H.topo + 1));
                }
                break;
            }
            case 6:
            {
                int i;
                if (estaVazia(&H)) {
                    printf("Historico vazio\n");
                } else {
                    printf("\nHISTORICO AO CONTRARIO:\n");
                    for (i = 0; i <= H.topo; i++) {
                        printf("%d\n", H.dados[i]);
                    }
                }
                break;
            }
            case 7:
                printf("Encerrando...\n");
                break;
            default:
                printf("Opcao invalida!\n");
        }
    }

    return 0;
}
