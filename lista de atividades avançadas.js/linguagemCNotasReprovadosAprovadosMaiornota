#include <stdio.h>
int main() {
   
float notas[5];
int soma = 0,media;
float maior = 0;

int aprovados = 0,reprovados = 0;
 for(int i=0; i<5; i++) {
     printf("Digite a nota: ", i + 1);
     scanf("%f", &notas[i]);
     soma=+notas[i];
      if(notas[i] >= 6) {
        aprovados++;
      } else {
          reprovados++;
      }
     for(int i = 0; i < 5; i++){
         if(notas[i] > maior){
             maior = notas[i];
         }
     }
     
 }
printf("A quantidade de aprovados foram: %d\n", aprovados);
printf("A quantidade de reprovados foram: %d\n", reprovados);
printf("A maior nota foi: %.2f\n",maior);
media = soma/5;
 printf("A media foi: %.2f\n",media);

    return 0;
}
