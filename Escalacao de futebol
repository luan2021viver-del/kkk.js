package br.senai.poo.lista07;

public class Principal {

    public static void main(String[] args) {

        Time time = new Time("Barcelona", "Carlos");

        time.contratarJogador("Pedro", 10);
        time.contratarJogador("Lucas", 7);
        time.contratarJogador("João", 9);
        time.contratarJogador("Gabriel", 11);
        time.contratarJogador("Rafael", 5);

        System.out.println("\nEscalando jogadores:\n");

        System.out.println("Pedro titular: "
                + time.escalarJogador("Pedro", SituacaoEscalacao.TITULAR));

        System.out.println("Lucas titular: "
                + time.escalarJogador("Lucas", SituacaoEscalacao.TITULAR));

        System.out.println("João titular: "
                + time.escalarJogador("João", SituacaoEscalacao.TITULAR));

        System.out.println("Gabriel reserva: "
                + time.escalarJogador("Gabriel", SituacaoEscalacao.RESERVA));

        System.out.println("Rafael reserva: "
                + time.escalarJogador("Rafael", SituacaoEscalacao.RESERVA));

        System.out.println("\nEscalação do time " + time.getNome());
        System.out.println("Técnico: " + time.getNomeTecnico());

        for (Jogador jogador : time.obterEscalacao()) {
            System.out.println(jogador);
        }
    }
}
