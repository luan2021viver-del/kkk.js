package br.senai.pa.lista07;

public enum SituacaoEscalacaoEnum {
	
	TITULAR(11),RESERVA(12);
	
	private Integer qtdMaxima;

	private SituacaoEscalacaoEnum(Integer qtdMaxima) {
		this.qtdMaxima = qtdMaxima;
	}

	public Integer getQtdMaxima() {
		return qtdMaxima;
	}	

}

