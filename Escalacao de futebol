package br.senai.poo.lista07;

import java.util.ArrayList;
import java.util.List;

public class Time {

    private String nome;
    private String nomeTecnico;
    private List<Jogador> jogadores;
    private List<Jogador> jogadoresEscalados;

    public Time(String nome, String nomeTecnico) {
        this.nome = nome;
        this.nomeTecnico = nomeTecnico;
        jogadores = new ArrayList<>();
        jogadoresEscalados = new ArrayList<>();
    }

    public void contratarJogador(String nome, int numeroCamisa) {
        Jogador jogador = new Jogador(nome, numeroCamisa);
        jogadores.add(jogador);

        System.out.println("Jogador contratado: " + nome);
    }

    public boolean escalarJogador(String nome, SituacaoEscalacao situacaoEscalacao) {

        Jogador jogadorEncontrado = null;

        for (Jogador jogador : jogadores) {
            if (jogador.getNome().equalsIgnoreCase(nome)) {
                jogadorEncontrado = jogador;
                break;
            }
        }

        if (jogadorEncontrado == null) {
            return false;
        }

        if (jogadoresEscalados.contains(jogadorEncontrado)) {
            return false;
        }

        int quantidade = 0;

        for (Jogador jogador : jogadoresEscalados) {
            if (jogador.getSituacaoEscalacao() == situacaoEscalacao) {
                quantidade++;
            }
        }

        if (quantidade >= situacaoEscalacao.getQuantidadeMaxima()) {
            return false;
        }

        jogadorEncontrado.setSituacaoEscalacao(situacaoEscalacao);
        jogadoresEscalados.add(jogadorEncontrado);

        return true;
    }

    public void removerJogadorEscalacao(String nome) {
        for (Jogador jogador : jogadoresEscalados) {
            if (jogador.getNome().equalsIgnoreCase(nome)) {
                jogadoresEscalados.remove(jogador);
                jogador.setSituacaoEscalacao(null);
                System.out.println("Jogador removido da escalação.");
                return;
            }
        }

        System.out.println("Jogador não encontrado na escalação.");
    }

    public List<Jogador> obterEscalacao() {
        return new ArrayList<>(jogadoresEscalados);
    }

    public String getNome() {
        return nome;
    }

    public void setNome(String nome) {
        this.nome = nome;
    }

    public String getNomeTecnico() {
        return nomeTecnico;
    }

    public void setNomeTecnico(String nomeTecnico) {
        this.nomeTecnico = nomeTecnico;
    }
}


