package br.senai.pa.lista07;

import java.util.Iterator;

public class Exemplo {

	private static String nomes[] = { "Gabriel", "Erik", "Samuel", "Luan", "Arthur" };

	public static void main(String[] args) {

		Time time = new Time("Bahia", "Rogerio Ceni");
		contratar5Jogadores(time);
		escalar3Titulares(time);
		escalar2Reservas(time);
		listarJogadoresEscalados(time);
		
		
		 time.contratarJogador("Gabriel", 2); 
		 
		 
		  time.contratarJogador("Gabriel Rodrigues", 10); 
		  time.contratarJogador("Erik", 9); 
		 time.contratarJogador("Samuel", 5); 
		 time.contratarJogador("Luan", 2); 
		 time.contratarJogador("Arthur", 2); 
		 
		 
		 time.escalarJogador("Gabriel", SituacaoEscalacaoEnum.TITULAR);
		 time.escalarJogador("Samuel", SituacaoEscalacaoEnum.RESERVA);
		 time.escalarJogador("Arthur", SituacaoEscalacaoEnum.RESERVA);
		 time.escalarJogador("Luan", SituacaoEscalacaoEnum.TITULAR);
		 time.escalarJogador("Erik", SituacaoEscalacaoEnum.TITULAR);
		 
		 listarJogadoresEscalados(time);
		 
		 
		 
	}

	private static void contratar5Jogadores(Time time) {
		for (Integer i = 0; i <= 4; i++) {
			time.escalarJogador(nomes[i], SituacaoEscalacaoEnum.TITULAR);
		}
	}
	private static void escalar3Titulares(Time time) {
		for (Integer i = 0; i <= 2; i++) {
			time.escalarJogador(nomes[i], SituacaoEscalacaoEnum.TITULAR);
		}
	}
	private static void escalar2Reservas(Time time) {
		for (Integer i = 3; i <= 4; i++) {
			time.escalarJogador(nomes[i], SituacaoEscalacaoEnum.RESERVA);
		}
	}

	private static void listarJogadoresEscalados(Time time) {
		System.out.println("Jogadores Escalados:");
		for (Jogador jogador : time.obterEscalacao()) {
			System.out.println(jogador);
		}
	}

}
