Select COUNT(*)  AS QUANTIDADE_TOTAL
from brinquedos;

Select SUM(preço) AS valor_total
from brinquedos;

Select AVG (preço) AS preco_medio
from brinquedos;

Select MAX(preço) AS brinquedo_mais_caro
from brinquedos;

Select MIN(preço) AS brinquedo_mais_barato
from brinquedos;

Select COUNT(*)  AS quantidade_jogos
from brinquedos
where categoria = 'jogos';


SELECT * FROM brinquedos;


