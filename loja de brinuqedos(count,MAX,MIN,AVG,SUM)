DROP DATABASE IF EXISTS lojaB;

CREATE DATABASE lojaB;

USE lojaB;

CREATE TABLE brinquedos (
    idB INT PRIMARY KEY AUTO_INCREMENT,
    nome VARCHAR(100) NOT NULL,
    categoria varchar(50),
    preço decimal(10,2),
    estoque int
);


